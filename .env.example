# Copy to .env.local for local development.
# For Vercel, add both values to the relevant project environment before deploying.
# Without them, /admin is disabled in production; local preview mode is development-only.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Never add a service_role key or Supabase secret key to a VITE_* variable.
